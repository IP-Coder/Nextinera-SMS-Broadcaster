<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMS Broadcaster"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forwards every incoming SMS to your server, then on to Telegram."
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server URL (your sms.php endpoint)"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/urlField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://yourdomain.com/sms/sms.php"
            android:inputType="textUri"
            android:autofillHints="url"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shared secret (must match config.php)"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/secretField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="the app_secret value"
            android:inputType="text"
            android:autofillHints="password"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device name (shown in Telegram)"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/deviceField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. My Phone"
            android:inputType="text"
            android:autofillHints="name"
            android:layout_marginBottom="14dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/enabledSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forwarding enabled"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save" />

        <Button
            android:id="@+id/testBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send test message"
            style="?attr/materialButtonOutlinedStyle" />

        <Button
            android:id="@+id/permBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant SMS permission"
            style="?attr/materialButtonOutlinedStyle" />

        <Button
            android:id="@+id/batteryBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow background (ignore battery optimization)"
            style="?attr/materialButtonOutlinedStyle" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="14dp"
            android:background="#11000000"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:text="" />

    </LinearLayout>
</ScrollView>
